# Logs
logs/
*.log

# Backups
backups/

# Environment
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Temporary files
tmp/
temp/
*.tmp

# Nginx backups locais (gerados por scripts)
docker/nginx/nginx.conf.backup.*

# Docker
.docker/

# Terraform
*.tfstate
*.tfstate.*
.terraform/
# .terraform.lock.hcl -> MANTIDO para reprodutibilidade (Production-grade)
backend.hcl
tfplan
tfplan*

# Defesa em profundidade (Segredos)
**/secrets/
**/*secret*.yaml
**/*secret*.json
!gitops/bootstrap/**/*.yaml # Permitir manifestos de ArgoCD
!gitops/manifests/**/*.yaml  # Permitir manifestos de infra

# Local tools
.tools/

# SSH keys (except public)
*.pem
*.key
!*.pub
# Chaves privadas SSH organizadas
keys/**/id_rsa
keys/**/id_ed25519
keys/**/*_key
keys/**/*.pem
# Permitir chaves públicas
!keys/**/*.pub
sky-poc-frontend/
bastion_key*
gitops/charts/common-app/.argocd-source-*.yaml
