############################################
# sky-poc-ai - .gitignore
############################################

# Python bytecode
__pycache__/
*.py[codz]
*$py.class

# C extensions
*.so

# Virtual environments
venv/
.venv/
env/
ENV/

# Environment files / secrets
.env
.env.*
*.env
*.env.*
.env.local
.env.backup
*.env.backup

# Database
*.db
*.sqlite
*.sqlite3

# Logs
*.log
logs/

# Cache / tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.coverage
htmlcov/

# Build / dist
build/
dist/
.eggs/
*.egg-info/
*.egg

# Celery
celerybeat-schedule
celerybeat.pid

# Temporary discovery/analysis files
discovered_schema*.json
*_schema_from_db.json

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# Cursor
.cursorignore
.cursorindexingignore

# Jupyter
.ipynb_checkpoints/

# Alembic
alembic/versions/*.pyc

# Credentials (não versionar)
config/gcp/service_account.json
*.json
!requirements.txt
