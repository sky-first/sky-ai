environment         = "prod"
resource_group_name = "sky-aks-prod-rg"
aks_cluster_name    = "sky-aks-prod"
dns_prefix          = "sky-aks-prod"
location            = "eastus2"
vnet_address_space  = ["10.2.0.0/16"]
service_cidr        = "10.3.0.0/16"
kubernetes_version  = "1.33.5"

# Production networking - Isolated VNet, no public IP restrictions
# Access via Bastion VM only for admin access
authorized_ips = [
  "81.84.211.111/32",
  "169.155.237.158/32",
  "20.97.244.91/32",
  "169.155.237.143/32",

]

# Domínios de produção (configurados em Ingress later)
# Frontend: workspace-prd.skyfirstlabs.com
# AI: workspace-prd-ai.skyfirstlabs.com
# Backend API: api-workspace-prd.skyfirstlabs.com

external_dns_identity_resource_group = "rg-core-infra-prd"

allowed_ssh_ips = [
  "81.84.211.111/32",
  "169.155.237.158/32",
  "20.97.244.91/32",
  "169.155.237.143/32",

]

# GitHub Actions Service Principal (for CI/CD Key Vault access)
github_actions_sp_object_id = "ac642806-ae70-4e1d-a800-c8ed0f43ecd0"
