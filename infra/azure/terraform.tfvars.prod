# Configurações para ambiente PROD
# Usado com workspace: prod

environment         = "prod"
# IMPORTANTE: Se a VM já existe, use o resource group existente
# Verificar com: az vm show -d -g <rg> -n ai-saas-vm --query resourceGroup -o tsv
resource_group_name = "rg-ai-saas-prod"  # Ajustar se necessário
location            = "eastus"
vm_name             = "ai-saas-vm"      # Nome da VM existente
vm_size             = "Standard_B2s"    # 2 vCPU, 4GB RAM (tamanho atual da VM)
admin_username      = "azureuser"

# Chave pública SSH
ssh_public_key = "../../keys/azure/id_rsa.pub"

# Git e Deploy
git_branch  = "main"
github_repo = "sky-first/sky-poc-infra"

# Subscription ID (será injetado via variável de ambiente ou secret)
# subscription_id será fornecido via ARM_SUBSCRIPTION_ID ou GitHub Secret

# Configurações de Segurança - Network Security Group
# IMPORTANTE: Em produção, restringir acesso para maior segurança

# SSH - Apenas IPs do time DevOps
# INSTRUÇÕES:
# 1. Descubra seu IP público: curl -s https://api.ipify.org
# 2. Adicione cada IP com /32 (ex: "203.0.113.10/32")
# 3. Para múltiplos IPs, adicione na lista separados por vírgula
# 4. Para CIDR de rede (ex: escritório), use formato CIDR (ex: "198.51.100.0/24")
#
# Exemplo com IP único:
# allowed_ssh_ips = ["203.0.113.10/32"]
#
# Exemplo com múltiplos IPs:
# allowed_ssh_ips = ["203.0.113.10/32", "198.51.100.20/32", "192.0.2.0/24"]
#
# ATENÇÃO: 
# - Se deixar ["0.0.0.0/0"], SSH será público (menos seguro, mas funcional)
# - Se deixar lista vazia [], a porta SSH será fechada (sem acesso)
# - Recomendado: Restringir para IPs específicos do time
#
# ============================================
# FASE 1: TESTE - Restrição por IP
# ============================================
# Esta é uma solução TEMPORÁRIA para permitir acesso durante testes.
# 
# IMPORTANTE: Após validar que tudo está funcionando, migre para:
#   - Azure Bastion (recomendado para produção)
#   - Just-In-Time (JIT) Access (alternativa grátis)
# 
# Veja: MIGRAR_PARA_BASTION.md ou MIGRAR_PARA_JIT.md
# ============================================
#
# IP atual do DevOps (descoberto automaticamente)
# Se seu IP mudar, atualize aqui ou use o script: ./scripts/update-ssh-ip.sh
allowed_ssh_ips = [
  "81.84.211.111/32",  # IP atual - atualize se mudar
  # Adicionar outros IPs do time quando necessário:
  # "198.51.100.20/32", # Membro 2 do time
  # "203.0.113.50/32",  # Membro 3 do time
  # "192.0.2.0/24",     # Rede do escritório (todos os IPs da rede)
]
#
# ============================================
# COMO ATUALIZAR SEU IP:
# ============================================
# Windows: powershell -ExecutionPolicy Bypass -File .\scripts\update-ssh-ip.sh
# Linux:   ./scripts/update-ssh-ip.sh
# Manual:  Edite esta linha acima com seu novo IP/32
# ============================================
#
# PROCESSO PARA ADICIONAR IPs DO TIME:
# 1. Cada membro executa: .\scripts\coletar_ips_time.ps1 (ou .sh no Linux)
# 2. Colete todos os IPs
# 3. Adicione na lista acima
# 4. Aplique: terraform apply -var-file=terraform.tfvars.prod
# 
# Veja: COMO_ADICIONAR_IPS_TIME.md para guia completo
#
# Para descobrir seu IP atual, execute:
#   Windows: powershell -ExecutionPolicy Bypass -File ..\..\scripts\get_my_ip.ps1
#   Linux:   ./scripts/get_my_ip.sh
#   Ou:      curl https://api.ipify.org

# PostgreSQL - Apenas rede interna da VM (recomendado para produção)
# O PostgreSQL deve ser acessível apenas dentro da rede interna (10.0.1.0/24)
# ou via IPs específicos se necessário acesso externo
allowed_postgres_ips = ["10.0.1.0/24"]   # Apenas rede interna da VM

# Frontend - Pode ser público se necessário para acesso web
frontend_public_access = true             # Libera frontend
allowed_frontend_ips   = ["0.0.0.0/0"]

# Backend - NUNCA público em produção (acessado apenas via proxy/nginx interno)
# O backend deve ser acessível apenas pela rede interna
backend_public_access = false             # Backend não deve ser público
allowed_backend_ips   = ["10.0.1.0/24"]  # Apenas rede interna (acesso via nginx)

# Proxy / Ingress (HTTP/HTTPS) permanece aberto
allowed_http_ips  = ["0.0.0.0/0"]
allowed_https_ips = ["0.0.0.0/0"]

# ============================================
# RECOMENDAÇÕES CRÍTICAS IMPLEMENTADAS
# ============================================

# Azure Bastion - Acesso SSH seguro (recomendado para produção)
# Se true, cria Azure Bastion e fecha porta SSH pública
# Se false, mantém SSH público (menos seguro)
enable_bastion = true

# Azure Monitor - Email para alertas (opcional mas recomendado)
# Configure um email para receber alertas de CPU, memória, disco, etc.
alert_email = "gustavo.mendonca@thedatafirst.com"
