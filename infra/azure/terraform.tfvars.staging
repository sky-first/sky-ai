# Configurações para ambiente STAGING
# Usado com workspace: staging

environment         = "staging"
resource_group_name = "rg-ai-saas-staging"
location            = "eastus"
vm_name             = "ai-saas-staging"
vm_size             = "Standard_B2ms"  # 2 vCPU, 8GB RAM
admin_username      = "azureuser"

# Chave pública SSH
ssh_public_key = "../../keys/azure/id_rsa.pub"

# Git e Deploy
git_branch  = "staging"
github_repo = "kaiquemendonca1/poc-deploy"

# Subscription ID (será injetado via variável de ambiente ou secret)
# subscription_id será fornecido via ARM_SUBSCRIPTION_ID ou GitHub Secret

# Configurações de Segurança - Network Security Group
allowed_ssh_ips      = ["0.0.0.0/0"]      # Aberto para o time (SSH)
allowed_postgres_ips = ["0.0.0.0/0"]      # Aberto para o time (Postgres)

frontend_public_access = true             # Libera frontend
allowed_frontend_ips   = ["0.0.0.0/0"]

backend_public_access = true              # Libera backend
allowed_backend_ips   = ["0.0.0.0/0"]

# Proxy / Ingress (HTTP/HTTPS) permanece aberto
allowed_http_ips  = ["0.0.0.0/0"]
allowed_https_ips = ["0.0.0.0/0"]
