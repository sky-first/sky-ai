# Configurações para ambiente POC-SKY
# Usado com workspace: poc-sky
# VM: poc-sky (Standard_D2s_v3 - 2 vCPU, 8GB RAM)

environment         = "poc-sky"
resource_group_name = "poc-sky"  # IMPORTANTE: usar minúsculas conforme Azure Portal
location            = "westeurope"  # VM já existe nesta região
vm_name             = "poc-sky"
vm_size             = "Standard_D2s_v3"  # 2 vCPU, 8GB RAM (mais potente)
admin_username      = "azureuser"

# Chave pública SSH
# IMPORTANTE: A VM já existe, então a chave SSH deve ser a mesma usada para acessar
# Se necessário, atualize o caminho abaixo
ssh_public_key = "../../keys/azure/id_rsa.pub"

# Git e Deploy
git_branch  = "main"  # Usar branch main para POC
github_repo = "sky-first/sky-poc-infra"

# Subscription ID (será injetado via variável de ambiente ou secret)
# subscription_id será fornecido via ARM_SUBSCRIPTION_ID ou GitHub Secret

# Configurações de Segurança - Network Security Group
# IMPORTANTE: A VM já existe, então essas regras serão aplicadas/atualizadas
# CRÍTICO: Com Azure Bastion habilitado (enable_bastion = true), 
# a porta SSH (22) NÃO será exposta publicamente.
# Acesso SSH será feito apenas via Azure Bastion (portal Azure ou CLI).
# 
# NOTA: allowed_ssh_ips é ignorado quando enable_bastion = true
# Se precisar desabilitar Bastion no futuro, configure allowed_ssh_ips com IPs específicos
allowed_ssh_ips      = ["0.0.0.0/0"]      # Ignorado quando enable_bastion = true
allowed_postgres_ips = ["10.0.1.0/24"]    # Apenas rede interna da VM (mais seguro)

frontend_public_access = true             # Libera frontend
allowed_frontend_ips   = ["0.0.0.0/0"]

# Backend - CRÍTICO: Restringido para rede interna (segurança)
# O backend deve ser acessível apenas pela rede interna (via nginx)
# Acesso externo deve ser feito apenas via proxy/nginx (portas 80/443)
backend_public_access = false             # Backend não deve ser público
allowed_backend_ips   = ["10.0.1.0/24"]   # Apenas rede interna (acesso via nginx)

# Proxy / Ingress (HTTP/HTTPS) permanece aberto
allowed_http_ips  = ["0.0.0.0/0"]
allowed_https_ips = ["0.0.0.0/0"]

# ============================================
# RECOMENDAÇÕES CRÍTICAS IMPLEMENTADAS
# ============================================

# Azure Bastion - Acesso SSH seguro (RECOMENDADO)
# CRÍTICO: Com Bastion habilitado, porta SSH (22) não será exposta publicamente
# Acesso SSH será feito apenas via Azure Bastion (mais seguro)
# Custo: ~$0.19/hora (~$140/mês) - considerar para ambientes críticos
enable_bastion = true  # POC: Bastion habilitado para segurança

# Azure Monitor - Email para alertas (opcional para POC)
# Configure um email para receber alertas de CPU, memória, disco, etc.
alert_email = "gustavo.mendonca@thedatafirst.com"

# ============================================
# NOTAS IMPORTANTES
# ============================================
# 1. A VM poc-sky JÁ EXISTE no Resource Group POC-SKY
# 2. Docker NÃO está instalado - será instalado automaticamente pelo setup.tf
# 3. O Terraform vai atualizar a infraestrutura existente (NSG, etc.)
# 4. Para usar esta VM, execute: terraform workspace select poc-sky (ou crie se não existir)

