# ==============================================================================
# TEMPLATE DE MONITORAMENTO (.env.monitoring.example)
# ==============================================================================

# Grafana Security
GF_SECURITY_ADMIN_PASSWORD=admin_dev_password

# Alertmanager SMTP Settings (Para testes de e-mail)
SMTP_HOST=smtp.gmail.com:587
SMTP_USER=alertmanager@example.com
SMTP_PASSWORD=app_password_here
SMTP_FROM=alertmanager@example.com

# Exporters (Credenciais para o Prometheus ler os bancos)
REDIS_PASSWORD=dev_redis_password
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev_password_only
POSTGRES_DB=ai_saas_db
