# ============================================
# CONFIGURAÇÃO DE AMBIENTE
# ============================================
# DEVOPS: Este arquivo é a FONTE ÚNICA DE VERDADE para configuração
# Todas as URLs e caminhos são gerenciados aqui e injetados via .env
#
# IMPORTANTE: Para ambiente LOCAL (com o proxy/Nginx do sky-poc-infra), use:
#   - NEXT_PUBLIC_API_URL=/api/v1
#   - CORS_ORIGINS=http://localhost:3000,http://localhost
#
# Para PRODUÇÃO (VM POC-SKY), use:
#   - NEXT_PUBLIC_API_URL=http://20.86.142.1/api/v1
#   - CORS_ORIGINS=http://20.86.142.1,http://20.86.142.1:3000,http://localhost:3000,http://localhost
#
# NOTA: Os scripts de deploy atualizam automaticamente estas variáveis
#       com o IP correto da VM durante o deploy.
# ============================================

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secure_password_here
POSTGRES_DB=ai_saas_db
POSTGRES_PORT=5433

# Redis
REDIS_PASSWORD=secure_redis_password_here
REDIS_PORT=6379

# Backend
BACKEND_PORT=8000
# Backend usa asyncpg (assíncrono)
BACKEND_DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER:-postgres}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB:-ai_saas_db}
JWT_SECRET_KEY=generate_a_secure_random_string_here
ENCRYPTION_KEY=generate_another_secure_key_here
DEBUG=false

# AI Engine (sky-poc-ai)
# AI agora usa asyncpg (migração para assíncrono concluída)
AI_DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER:-postgres}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB:-ai_saas_db}

# CORS - Configure conforme ambiente
# CRÍTICO: NUNCA use "*" ou "0.0.0.0" - isso permite qualquer origem (vulnerabilidade)
# LOCAL: http://localhost:3000,http://localhost
# PRODUÇÃO: inclua apenas origens específicas e confiáveis
# Exemplo: CORS_ORIGINS=http://seu-dominio.com,https://seu-dominio.com,http://localhost:3000
# PRODUÇÃO (POC-SKY): http://20.86.142.1,http://20.86.142.1:3000,http://localhost:3000,http://localhost
# NOTA: Scripts de deploy atualizam automaticamente com o IP correto da VM
CORS_ORIGINS=http://localhost:3000,http://localhost

SENTRY_DSN=

# Frontend
FRONTEND_PORT=3000
# IMPORTANTE: Configure conforme ambiente
# DEVOPS: Esta variável é CRÍTICA - o frontend usa para chamar o backend
# 
# OPÇÕES (escolha UMA):
#   1. Path relativo (RECOMENDADO para produção):
#      NEXT_PUBLIC_API_URL=/api/v1
#      - Funciona através do Nginx, independente do IP
#      - Evita problemas de CORS e mixed-content
#
#   2. URL completa com IP público:
#      NEXT_PUBLIC_API_URL=http://20.86.142.1/api/v1
#      - Use quando precisar de URL absoluta
#      - Scripts de deploy atualizam automaticamente
#
# LOCAL (com proxy Nginx do sky-poc-infra): /api/v1
# (sem proxy): http://localhost:8000/api/v1
# PRODUÇÃO (POC-SKY): http://20.86.142.1/api/v1 ou /api/v1
# NOTA: Scripts de deploy atualizam automaticamente com o IP correto
NEXT_PUBLIC_API_URL=/api/v1

# ============================================
# AI Engine (sky-poc-ai) - "cérebro"
# ============================================
# Por padrão o backend pode operar em modo "mock".
# Para ativar a IA real, configure:
#   AI_SERVICE_TYPE=real
#   OPENAI_API_KEY=<sua-chave>
#
# URL interna do serviço de IA (dentro do docker compose):
#   http://ai:8001
AI_SERVICE_TYPE=mock
AI_SERVICE_URL=http://ai:8001
OPENAI_API_KEY=fmYAb1A8iItJ54cVyhxVTH6SsLTlh0BEkF0Ri5069kzwx9NBxp4uC29POkvZpUPeTOEbPT3BlbkFJ47D9AN0Uqr5oWpu9LK2ckP8_vMwMl1zyv5gY06gl6hY9_nkUpbvPUNEULssgH50gXavYc1iLsA
