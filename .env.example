# ─── AI Provider ──────────────────────────────────────────────────────────
# "ollama" (default, uses RunPod-hosted Qwen 2.5 Coder 32B) or "openai".
AI_PROVIDER=ollama

# ─── Ollama / RunPod ──────────────────────────────────────────────────────
# Pod's proxy URL. Format: https://<pod-id>-<port>.proxy.runpod.net
# Current dev pod: 3hd6i6wxtzbbe5 on RTX A6000 (US-TX-1)
OLLAMA_BASE_URL=https://3hd6i6wxtzbbe5-11434.proxy.runpod.net

# ─── OpenAI (fallback / premium tier) ─────────────────────────────────────
# Only consumed when AI_PROVIDER=openai or when a per-request override asks.
OPENAI_API_KEY=sk-proj-replace-me

# ─── Backend + JWT ────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:8000/api/v1
JWT_SECRET_KEY=replace-me-with-32-bytes-hex

# ─── RunPod lifecycle (optional — used by ops scripts) ────────────────────
# API key + Pod ID enable the on-pod auto-stop script (scripts/runpod_auto_stop.sh)
# and any future wake-on-demand wrapper. NEVER commit real values.
# RUNPOD_API_KEY=rpa_replace-me
# RUNPOD_POD_ID=3hd6i6wxtzbbe5
